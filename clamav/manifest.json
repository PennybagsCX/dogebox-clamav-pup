{
  "manifestVersion": 1,
  "meta": {
    "name": "ClamAV",
    "version": "0.0.17",
    "logoPath": "logo.png",
    "shortDescription": "Antivirus scanner with quarantine",
    "longDescription": "ClamAV pup for Dogebox: inotify-based real-time scan + hourly full scan of qBittorrent and *arr download dirs. Infected files are quarantined to /storage/quarantine, a status page is served at the WebUI, and signature DB updates via freshclam.",
    "upstreamVersions": {
      "ClamAV": "1.x"
    }
  },
  "config": {
    "sections": null
  },
  "container": {
    "build": {
      "nixFile": "pup.nix",
      "nixFileSha256": "10bbe5afdc66f6237d34a5f2f80b44d549ee780098a45c0a42974f8ff981c2da"
    },
    "services": [
      {
        "name": "clamav-daemon",
        "command": {
          "exec": "/bin/run-clamd.sh",
          "cwd": "",
          "env": null
        }
      },
      {
        "name": "clamav-scanner",
        "command": {
          "exec": "/bin/run-scanner.sh",
          "cwd": "",
          "env": null
        }
      },
      {
        "name": "clamav-freshclam",
        "command": {
          "exec": "/bin/run-freshclam.sh",
          "cwd": "",
          "env": null
        }
      },
      {
        "name": "clamav-webui",
        "command": {
          "exec": "/bin/run-webui.sh",
          "cwd": "",
          "env": null
        }
      }
    ],
    "exposes": [
      {
        "name": "web",
        "type": "http",
        "port": 9000,
        "interfaces": null,
        "listenOnHost": true,
        "webUI": true
      }
    ],
    "requiresInternet": true
  },
  "interfaces": null,
  "dependencies": null,
  "metrics": null
}